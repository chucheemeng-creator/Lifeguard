# Lifeguard 的 Telegram 設定 / Telegram settings for Lifeguard
#
# 用法 / How to use:
#   1. 把這個檔案複製一份,改名為 .env,放在 Lifeguard.exe 同一個資料夾。
#      Copy this file, rename the copy to .env, and keep it next to Lifeguard.exe.
#   2. 填入下面兩個值,存檔後重新啟動 Lifeguard(.env 不會自動重新載入)。
#      Fill in the two values below, save, then restart Lifeguard (.env is not reloaded live).
#
# 沒有 .env 也能執行,只是不會發 Telegram 通知。
# Lifeguard still runs without .env; it just sends no Telegram alerts.
#
# .env 內含密鑰,絕對不要提交到 Git 或分享給別人。
# .env holds a secret. Never commit it to Git or share it.

# Bot Token:在 Telegram 找 @BotFather,送 /newbot 建立機器人後取得。
# Bot token: talk to @BotFather on Telegram and send /newbot to create a bot.
TelegramBotToken=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Chat ID:接收通知的對象。先傳一則訊息給你的機器人,再用瀏覽器開啟
#   https://api.telegram.org/bot<你的Token>/getUpdates
# 回傳內容裡 "chat":{"id": 後面的數字就是 Chat ID。
# Chat ID: who receives the alerts. Send any message to your bot, then open
#   https://api.telegram.org/bot<YourToken>/getUpdates
# in a browser. The number after "chat":{"id": is your chat ID.
TelegramChatId=123456789
